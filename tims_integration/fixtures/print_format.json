[
 {
  "absolute_value": 0,
  "align_labels_right": 0,
  "custom_format": 1,
  "default_print_language": "en",
  "disabled": 0,
  "doc_type": "Sales Invoice",
  "docstatus": 0,
  "doctype": "Print Format",
  "font_size": 0,
  "html": "{%- set is_return = doc.is_return -%}\n{%- set title = \"CREDIT NOTE\" if is_return else \"TAX INVOICE\" -%}\n{%- set cur = doc.currency -%}\n{%- set sign = -1 if is_return else 1 -%}\n\n{%- macro money(v) -%}\n{{ frappe.utils.fmt_money(frappe.utils.flt(v) * sign, currency=cur) }}\n{%- endmacro -%}\n\n{%- set bands = [\n    (\"A\", \"16%\",         doc.custom_taxbl_amount_a, doc.custom_tax_a),\n    (\"B\", \"8%\",          doc.custom_taxbl_amount_b, doc.custom_tax_b),\n    (\"C\", \"10%\",         doc.custom_taxbl_amount_c, doc.custom_tax_c),\n    (\"D\", \"2%\",          doc.custom_taxbl_amount_d, doc.custom_tax_d),\n    (\"E\", \"Zero Rated\",  doc.custom_taxbl_amount_e, doc.custom_tax_e)\n] -%}\n\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n       style=\"font-family:Helvetica,Arial,sans-serif;font-size:11px;color:#000;\">\n\n  <!-- ============ TITLE ============ -->\n  <tr>\n    <td align=\"center\" style=\"padding:0 0 8px 0;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr>\n          <td align=\"center\" style=\"border-top:2px solid #000;border-bottom:2px solid #000;padding:6px 0;\">\n            <span style=\"font-size:16px;font-weight:bold;letter-spacing:2px;\">{{ title }}</span>\n            {% if doc.custom_sent_to_kra %}\n              <br><span style=\"font-size:9px;letter-spacing:1px;\">FISCAL RECEIPT &mdash; KRA TIMS</span>\n            {% endif %}\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n\n  <!-- ============ PARTIES / META ============ -->\n  <tr>\n    <td style=\"padding:0 0 8px 0;\">\n      <table width=\"100%\" cellpadding=\"4\" cellspacing=\"0\" border=\"0\"\n             style=\"border:1px solid #000;border-collapse:collapse;\">\n        <tr>\n          <td width=\"55%\" valign=\"top\" style=\"border-right:1px solid #000;\">\n            <b>{{ _(\"Billed To\") }}</b><br>\n            <b>{{ doc.customer_name or doc.customer }}</b><br>\n            {%- if doc.address_display %}{{ doc.address_display }}{% endif -%}\n            {%- if doc.tax_id %}<br>{{ _(\"PIN\") }}: <b>{{ doc.tax_id }}</b>{% endif -%}\n          </td>\n          <td width=\"45%\" valign=\"top\">\n            <table width=\"100%\" cellpadding=\"1\" cellspacing=\"0\" border=\"0\" style=\"font-size:11px;\">\n              <tr>\n                <td width=\"45%\">{{ _(\"Invoice No\") }}</td>\n                <td><b>{{ doc.name }}</b></td>\n              </tr>\n              <tr>\n                <td>{{ _(\"Date\") }}</td>\n                <td>{{ frappe.utils.formatdate(doc.posting_date, \"dd-MM-yyyy\") }}</td>\n              </tr>\n              <tr>\n                <td>{{ _(\"Time\") }}</td>\n                <td>{{ doc.posting_time }}</td>\n              </tr>\n              {% if is_return and doc.return_against %}\n              <tr>\n                <td>{{ _(\"Against\") }}</td>\n                <td>{{ doc.return_against }}</td>\n              </tr>\n              {% endif %}\n              <tr>\n                <td>{{ _(\"Currency\") }}</td>\n                <td>{{ cur }}</td>\n              </tr>\n            </table>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n\n  <!-- ============ ITEMS ============ -->\n  <tr>\n    <td style=\"padding:0 0 8px 0;\">\n      <table width=\"100%\" cellpadding=\"4\" cellspacing=\"0\" border=\"0\"\n             style=\"border:1px solid #000;border-collapse:collapse;\">\n        <thead>\n          <tr style=\"background:#eee;\">\n            <th width=\"4%\"  align=\"center\" style=\"border:1px solid #000;\">#</th>\n            <th width=\"42%\" align=\"left\"   style=\"border:1px solid #000;\">{{ _(\"Description\") }}</th>\n            <th width=\"8%\"  align=\"center\" style=\"border:1px solid #000;\">{{ _(\"Tax\") }}</th>\n            <th width=\"10%\" align=\"right\"  style=\"border:1px solid #000;\">{{ _(\"Qty\") }}</th>\n            <th width=\"8%\"  align=\"center\" style=\"border:1px solid #000;\">{{ _(\"UOM\") }}</th>\n            <th width=\"14%\" align=\"right\"  style=\"border:1px solid #000;\">{{ _(\"Rate\") }}</th>\n            <th width=\"14%\" align=\"right\"  style=\"border:1px solid #000;\">{{ _(\"Amount\") }}</th>\n          </tr>\n        </thead>\n        <tbody>\n          {% for item in doc.items %}\n          <tr>\n            <td align=\"center\" style=\"border:1px solid #000;\">{{ loop.index }}</td>\n            <td style=\"border:1px solid #000;\">\n              <b>{{ item.item_name }}</b>\n              {%- if item.item_code != item.item_name %}<br><span style=\"font-size:9px;\">{{ item.item_code }}</span>{% endif -%}\n            </td>\n            <td align=\"center\" style=\"border:1px solid #000;\">{{ doc.custom_taxation_type or \"-\" }}</td>\n            <td align=\"right\"  style=\"border:1px solid #000;\">{{ frappe.utils.flt(item.qty) * sign }}</td>\n            <td align=\"center\" style=\"border:1px solid #000;\">{{ item.uom }}</td>\n            <td align=\"right\"  style=\"border:1px solid #000;\">{{ frappe.utils.fmt_money(item.rate, currency=cur) }}</td>\n            <td align=\"right\"  style=\"border:1px solid #000;\">{{ money(item.amount) }}</td>\n          </tr>\n          {% endfor %}\n        </tbody>\n      </table>\n    </td>\n  </tr>\n\n  <!-- ============ VAT BREAKDOWN + TOTALS ============ -->\n  <tr>\n    <td style=\"padding:0 0 8px 0;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr>\n          <td width=\"52%\" valign=\"top\" style=\"padding-right:6px;\">\n            <table width=\"100%\" cellpadding=\"4\" cellspacing=\"0\" border=\"0\"\n                   style=\"border:1px solid #000;border-collapse:collapse;\">\n              <tr style=\"background:#eee;\">\n                <th align=\"left\"  style=\"border:1px solid #000;\">{{ _(\"VAT Band\") }}</th>\n                <th align=\"right\" style=\"border:1px solid #000;\">{{ _(\"Taxable\") }}</th>\n                <th align=\"right\" style=\"border:1px solid #000;\">{{ _(\"VAT\") }}</th>\n              </tr>\n              {% for code, label, taxable, vat in bands %}\n                {% if frappe.utils.flt(taxable) or frappe.utils.flt(vat) %}\n                <tr>\n                  <td style=\"border:1px solid #000;\">{{ code }} &mdash; {{ label }}</td>\n                  <td align=\"right\" style=\"border:1px solid #000;\">{{ money(taxable) }}</td>\n                  <td align=\"right\" style=\"border:1px solid #000;\">{{ money(vat) }}</td>\n                </tr>\n                {% endif %}\n              {% endfor %}\n            </table>\n          </td>\n\n          <td width=\"48%\" valign=\"top\">\n            <table width=\"100%\" cellpadding=\"4\" cellspacing=\"0\" border=\"0\"\n                   style=\"border:1px solid #000;border-collapse:collapse;\">\n              <tr>\n                <td style=\"border:1px solid #000;\">{{ _(\"Net Total\") }}</td>\n                <td align=\"right\" style=\"border:1px solid #000;\">{{ money(doc.net_total) }}</td>\n              </tr>\n              {% for tax in doc.taxes %}\n              <tr>\n                <td style=\"border:1px solid #000;\">{{ tax.description }}</td>\n                <td align=\"right\" style=\"border:1px solid #000;\">{{ money(tax.tax_amount) }}</td>\n              </tr>\n              {% endfor %}\n              {% if doc.discount_amount %}\n              <tr>\n                <td style=\"border:1px solid #000;\">{{ _(\"Discount\") }}</td>\n                <td align=\"right\" style=\"border:1px solid #000;\">- {{ money(doc.discount_amount) }}</td>\n              </tr>\n              {% endif %}\n              <tr style=\"background:#eee;\">\n                <td style=\"border:1px solid #000;\"><b>{{ _(\"Grand Total\") }}</b></td>\n                <td align=\"right\" style=\"border:1px solid #000;\"><b>{{ money(doc.grand_total) }}</b></td>\n              </tr>\n              {% if not doc.disable_rounded_total and doc.rounded_total %}\n              <tr>\n                <td style=\"border:1px solid #000;\">{{ _(\"Rounded Total\") }}</td>\n                <td align=\"right\" style=\"border:1px solid #000;\">{{ money(doc.rounded_total) }}</td>\n              </tr>\n              {% endif %}\n            </table>\n\n            {% if doc.in_words %}\n            <table width=\"100%\" cellpadding=\"4\" cellspacing=\"0\" border=\"0\"\n                   style=\"border:1px solid #000;border-collapse:collapse;margin-top:4px;\">\n              <tr>\n                <td style=\"font-size:10px;\"><i>{{ doc.in_words }}</i></td>\n              </tr>\n            </table>\n            {% endif %}\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n\n  <!-- ============ KRA FISCAL BLOCK ============ -->\n  {% if doc.custom_sent_to_kra %}\n  <tr>\n    <td style=\"padding:0 0 8px 0;\">\n      <table width=\"100%\" cellpadding=\"6\" cellspacing=\"0\" border=\"0\"\n             style=\"border:2px solid #000;border-collapse:collapse;\">\n        <tr>\n          <td colspan=\"2\" align=\"center\"\n              style=\"border-bottom:1px solid #000;background:#eee;font-weight:bold;letter-spacing:1px;\">\n            {{ _(\"KRA FISCAL DETAILS\") }}\n          </td>\n        </tr>\n        <tr>\n          <td width=\"68%\" valign=\"top\" style=\"border-right:1px solid #000;\">\n            <table width=\"100%\" cellpadding=\"2\" cellspacing=\"0\" border=\"0\" style=\"font-size:11px;\">\n              <tr>\n                <td width=\"42%\">{{ _(\"CU Invoice No\") }} (CUIN)</td>\n                <td><b>{{ doc.custom_cuin or \"-\" }}</b></td>\n              </tr>\n              <tr>\n                <td>{{ _(\"CU Serial No\") }} (CUSN)</td>\n                <td>{{ doc.custom_cusn or \"-\" }}</td>\n              </tr>\n              <tr>\n                <td>{{ _(\"Trader Invoice No\") }} (TSIN)</td>\n                <td>{{ doc.custom_tsin or \"-\" }}</td>\n              </tr>\n              <tr>\n                <td>{{ _(\"Signing Time\") }}</td>\n                <td>{{ frappe.utils.formatdate(doc.custom_kra_signing_time, \"dd-MM-yyyy\") if doc.custom_kra_signing_time else \"-\" }}</td>\n              </tr>\n              <tr>\n                <td>{{ _(\"Taxation Type\") }}</td>\n                <td>{{ doc.custom_taxation_type or \"-\" }}</td>\n              </tr>\n            </table>\n          </td>\n\n          <td width=\"32%\" align=\"center\" valign=\"middle\">\n            {% if doc.custom_kra_qr_code_data %}\n              <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=150x150&margin=0&data={{ doc.custom_kra_qr_code_data | urlencode }}\"\n                   width=\"110\" height=\"110\" alt=\"KRA QR Code\"\n                   style=\"display:block;margin:0 auto;\">\n              <div style=\"font-size:8px;margin-top:3px;\">{{ _(\"Scan to verify on iTax\") }}</div>\n            {% else %}\n              <div style=\"font-size:9px;\">{{ _(\"No QR code returned\") }}</div>\n            {% endif %}\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n  {% else %}\n  <tr>\n    <td align=\"center\" style=\"padding:6px;border:1px dashed #000;font-size:10px;\">\n      {{ _(\"NOT FISCALISED &mdash; this document has not been transmitted to KRA\") }}\n    </td>\n  </tr>\n  {% endif %}\n\n  <!-- ============ FOOTER ============ -->\n  <tr>\n    <td style=\"padding-top:6px;\">\n      <table width=\"100%\" cellpadding=\"2\" cellspacing=\"0\" border=\"0\" style=\"font-size:9px;\">\n        <tr>\n          <td align=\"left\" width=\"50%\">\n            {% if doc.remarks and doc.remarks != \"No Remarks\" %}{{ doc.remarks }}{% endif %}\n          </td>\n          <td align=\"right\" width=\"50%\">\n            {{ _(\"Printed\") }}: {{ frappe.utils.format_datetime(frappe.utils.now(), \"dd-MM-yyyy HH:mm\") }}\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n\n</table>\n",
  "line_breaks": 0,
  "margin_bottom": 10.0,
  "margin_left": 10.0,
  "margin_right": 10.0,
  "margin_top": 10.0,
  "module": "TIMS Integration",
  "name": "Tax Invoice KRA",
  "page_number": "Hide",
  "print_format_builder": 0,
  "print_format_type": "Jinja",
  "raw_printing": 0,
  "show_section_headings": 0,
  "standard": "No"
 }
]
